-- =========================================================================
-- SISTEMA DE ESPERA ANTI-CARREGAMENTO LENTO (ESSENCIAL PARA AUTOEXEC)
-- =========================================================================
repeat task.wait() until game:IsLoaded()

local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer

