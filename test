-- Função auxiliar para atualizar o placar na tela
local function atualizarPlacar(textoEsquerda, textoDireita)
    if not scriptAtivo then return end
    if textoDireita then
        nomeLabel.Text = tostring(textoEsquerda) .. ":                                  " .. tostring(textoDireita)
    else
        nomeLabel.Text = tostring(textoEsquerda)
    end
end

-- =========================================================================
-- 3. VERIFICAÇÃO DE MAPA E LEADERSTATS (Blox Fruits vs Outros Jogos)
-- =========================================================================
task.spawn(function()
    local placeId = game.PlaceId
    local leaderstats = localPlayer:WaitForChild("leaderstats", 20)

    if not leaderstats or not scriptAtivo then 
        nomeLabel.Text = "" 
        return 
    end

    -- IDs de mapas do Blox Fruits (Sea 1, Sea 2 e Sea 3)
    if placeId == 7449423635 or placeId == 4442272183 or placeId == 2753915549 then
        local statusPrincipal = leaderstats:WaitForChild("Bounty/Honor", 20)
        if statusPrincipal and scriptAtivo then
            atualizarPlacar("bounty/honor", statusPrincipal.Value)
            
            local conexao
            conexao = statusPrincipal.Changed:Connect(function(novoValor)
                if not scriptAtivo then conexao:Disconnect() return end
                atualizarPlacar("bounty/honor", novoValor)
            end)
        else
            nomeLabel.Text = ""
        end
    else
        -- Para outros jogos, pega o primeiro valor que encontrar no leaderstats
        local statusPrincipal = leaderstats:GetChildren()[1]
        if statusPrincipal and (statusPrincipal:IsA("ValueBase") or statusPrincipal:IsA("StringValue")) and scriptAtivo then
            atualizarPlacar(statusPrincipal.Name, statusPrincipal.Value)
            
            local conexao
            conexao = statusPrincipal.Changed:Connect(function(novoValor)
                if not scriptAtivo then conexao:Disconnect() return end
                atualizarPlacar(statusPrincipal.Name, novoValor)
            end)
        else
            nomeLabel.Text = ""
        end
    end
end)

-- =========================================================================
-- 4. ATALHO PARA LIGAR/DESLIGAR (Tecla Right-Alt)
-- =========================================================================
local conexaoInput
conexaoInput = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not scriptAtivo then conexaoInput:Disconnect() return end
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.RightAlt then
        screenGui.Enabled = not screenGui.Enabled
    end
end)

-- =========================================================================
-- 5. SISTEMA ANTIFALHAS DE AUTO-EXECUÇÃO (Para teleportes automáticos)
-- =========================================================================
local function persistenciaDeScript()
    local scriptBruto = [[
        repeat task.wait() until game:IsLoaded()
        loadstring(game:HttpGet('https://raw.githubusercontent.com/LucasXnsLz/XnsLz/refs/heads/main/test'))()
    ]]

    if queue_on_teleport then
        queue_on_teleport(scriptBruto)
    elseif syn and syn.queue_on_teleport then
        syn.queue_on_teleport(scriptBruto)
    elseif fluxus and fluxus.queue_on_teleport then
        fluxus.queue_on_teleport(scriptBruto)
    end
end

local conexaoTeleport
conexaoTeleport = localPlayer.OnTeleport:Connect(function(State)
    if not scriptAtivo then conexaoTeleport:Disconnect() return end
    if State == Enum.TeleportState.Started or State == Enum.TeleportState.InProgress then
        persistenciaDeScript()
    end
end)
