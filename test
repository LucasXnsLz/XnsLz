-- FUNÇÃO PADRÃO: Altera o texto mantendo o espaçamento original
local function atualizarPlacar(textoEsquerda, textoDireita)
    if textoDireita then
        nomeLabel.Text = tostring(textoEsquerda) .. ":                                          " .. tostring(textoDireita)
    else
        nomeLabel.Text = tostring(textoEsquerda)
    end
end

-- 3. VERIFICAÇÃO DE MAPA (Blox Fruits vs Outros Jogos)
task.spawn(function()
    local placeId = game.PlaceId
    local leaderstats = localPlayer:WaitForChild("leaderstats", 15)
    
    -- Se não encontrar a pasta leaderstats, deixa invisível e para a execução
    if not leaderstats then
        nomeLabel.Text = ""
        return
    end

    -- IDs dos 3 Seas do Blox Fruits
    if placeId == 7449423635 or placeId == 4442272183 or placeId == 2753915549 then
        -- SISTEMA PARA BLOX FRUITS (Fixo como bounty/honor e sem vírgula)
        local statusPrincipal = leaderstats:WaitForChild("Bounty/Honor", 15)
        
        if statusPrincipal then
            atualizarPlacar("bounty/honor", statusPrincipal.Value)
            
            statusPrincipal.Changed:Connect(function(novoValor)
                atualizarPlacar("bounty/honor", novoValor)
            end)
        else
            nomeLabel.Text = "" -- Se sumir por algum motivo, não exibe erro na tela
        end
    else
        -- SISTEMA PARA OUTROS JOGOS (Pega o NOME REAL do status, ex: Cash: 0)
        local statusPrincipal = leaderstats:GetChildren()[1]
        
        if statusPrincipal and (statusPrincipal:IsA("ValueBase") or statusPrincipal:IsA("StringValue")) then
            atualizarPlacar(statusPrincipal.Name, statusPrincipal.Value)
            
            statusPrincipal.Changed:Connect(function(novoValor)
                atualizarPlacar(statusPrincipal.Name, novoValor)
            end)
        else
            nomeLabel.Text = "" -- Caso a pasta exista mas não tenha nenhum valor dentro
        end
    end
end)

