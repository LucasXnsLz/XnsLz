-- CONFIGURAÇÃO INICIAL E LIMPEZA DE SEGURANÇA
-- =========================================================================
local Teams = game:GetService("Teams")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local TeleportService = game:GetService("TeleportService")

local playerGui = localPlayer:WaitForChild("PlayerGui", 20)
if not playerGui then return end

-- Identificador único para evitar duplicações
local ID_SCRIPT = "ConsoleHeaderGui"

-- Remove a GUI antiga se ela já existir na tela
local antigaGui = playerGui:FindFirstChild(ID_SCRIPT)
if antigaGui then
    antigaGui:Destroy()
end

-- Interrompe loops de execuções anteriores para poupar memória
if _G.CancelarThreadAntigaXnsLz then
    _G.CancelarThreadAntigaXnsLz()
end

local scriptAtivo = true
_G.CancelarThreadAntigaXnsLz = function()
    scriptAtivo = false
end

