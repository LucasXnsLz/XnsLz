-- 5. SISTEMA ANTIFALHAS DE AUTO-EXECUÇÃO (Para teleportes automáticos)      --
-- ========================================================================= --
local function persistenciaDeScript()
	local scriptBruto = [[
		repeat task.wait() until game:IsLoaded()
		loadstring(game:HttpGet('https://raw.githubusercontent.com/LucasXnsLz/XnsLz/refs/heads/main/test'))()
	]]
	
	if queue_on_teleport then
		queue_on_teleport(scriptBruto)
	elseif syn and syn.queue_on_teleport then
		syn.queue_on_teleport(scriptBruto)
	elseif fluxus and fluxus.queue_on_teleport then
		fluxus.queue_on_teleport(scriptBruto)
	end
end

local conexaoTeleport
conexaoTeleport = localPlayer.OnTeleport:Connect(function(State)
	if not scriptAtivo then
		conexaoTeleport:Disconnect()
		return
	end
	if State == Enum.TeleportState.Started or State == Enum.TeleportState.InProgress then
		persistenciaDeScript()
	end
end)
