-- Função auxiliar para atualizar o placar separadamente
local function atualizarPlacar(textoEsquerda, textoDireita)
	if not scriptAtivo then return end
	if textoDireita then
		nomeLabel.Text = tostring(textoEsquerda) .. ":"         
		valorLabel.Text = tostring(textoDireita)
	else
		nomeLabel.Text = tostring(textoEsquerda)
		valorLabel.Text = ""
	end
end

-- ========================================================================= --
-- 3. VERIFICAÇÃO DE MAPA E LEADERSTATS (Blox Fruits vs Outros Jogos)        --
-- ========================================================================= --
task.spawn(function()
	local placeId = game.PlaceId
	local leaderstats = localPlayer:WaitForChild("leaderstats", 20)
	
	if not leaderstats or not scriptAtivo then
		nomeLabel.Text = ""
		valorLabel.Text = ""
		return
	end
	
	-- IDs de mapas do Blox Fruits (Sea 1, Sea 2 e Sea 3)
	if placeId == 7449423635 or placeId == 4442272183 or placeId == 2753915549 then
		local statusPrincipal = leaderstats:WaitForChild("Bounty/Honor", 20)
		if statusPrincipal and scriptAtivo then
			atualizarPlacar("Bounty/Honor", statusPrincipal.Value)
			local conexao
			conexao = statusPrincipal.Changed:Connect(function(novoValor)
				if not scriptAtivo then
					conexao:Disconnect()
					return
				end
				atualizarPlacar("Bounty/Honor", novoValor)
			end)
		else
			nomeLabel.Text = ""
			valorLabel.Text = ""
		end
	else
		-- Para outros jogos, pega o primeiro valor que encontrar no leaderstats
		local statusPrincipal = leaderstats:GetChildren()[1]
		if statusPrincipal and (statusPrincipal:IsA("ValueBase") or statusPrincipal:IsA("StringValue")) and scriptAtivo then
			-- Primeira letra em maiúsculo para fins estéticos (ex: money -> Money)
			local nomeFormatado = statusPrincipal.Name:gsub("^%l", string.upper)
			atualizarPlacar(nomeFormatado, statusPrincipal.Value)
			
			local conexao
			conexao = statusPrincipal.Changed:Connect(function(novoValor)
				if not scriptAtivo then
					conexao:Disconnect()
					return
				end
				atualizarPlacar(nomeFormatado, novoValor)
			end)
		else
			nomeLabel.Text = ""
			valorLabel.Text = ""
		end
	end
end)

-- ========================================================================= --
-- 4. ATALHO PARA LIGAR/DESLIGAR (Tecla Right-Alt)                           --
-- ========================================================================= --
local conexaoInput
conexaoInput = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not scriptAtivo then
		conexaoInput:Disconnect()
		return
	end
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.RightAlt then
		screenGui.Enabled = not screenGui.Enabled
	end
end)

